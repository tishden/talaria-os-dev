diff -ruN musl-1.2.5/src/thread/talaria_uwait.c musl-tal/src/thread/talaria_uwait.c
--- musl-1.2.5/src/thread/talaria_uwait.c	1970-01-01 03:00:00.000000000 +0300
+++ musl-tal/src/thread/talaria_uwait.c	2026-08-23 18:03:21.218759322 +0300
@@ -0,0 +1,41 @@
+/* Talaria PLAN-SYNC (the tier 1): a user-mode monitor-wait for musl's futex paths.
+ * With WAITPKG (umonitor/umwait, Intel) or MONITORX (monitorx/mwaitx, AMD) the waiting
+ * for a change of the word goes in ring 3 without a syscall: the sleeper arms the monitor
+ * on the word, the waker wakes it by the write itself (its FUTEX_WAKE becomes an insurance).
+ * Without the extensions it is 0, and the futex remains (Talaria's kernel sleeps with an mwait on the word). */
+#include <stdint.h>
+
+static volatile int __tal_tier = -1;
+
+static void __tal_detect(void)
+{
+	unsigned a, b, c, d;
+	__asm__ volatile ("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d) : "a"(7), "c"(0));
+	if (c & (1u<<5)) { __tal_tier = 1; return; }
+	__asm__ volatile ("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d) : "a"(0x80000001u), "c"(0));
+	__tal_tier = (c & (1u<<29)) ? 2 : 0;
+}
+
+int __tal_uwait_ok(void)
+{
+	if (__tal_tier < 0) __tal_detect();
+	return __tal_tier;
+}
+
+/* One quantum of sleep (~150 us) until a write into the word/an interrupt. The arm/check
+ * race is closed by the order: the monitor -> a recheck -> the sleep. */
+void __tal_uwait1(volatile int *addr, int val)
+{
+	if (__tal_tier == 1) {
+		unsigned lo, hi;
+		__asm__ volatile ("rdtsc" : "=a"(lo), "=d"(hi));
+		uint64_t dl = ((uint64_t)hi<<32 | lo) + 500000;
+		__asm__ volatile ("umonitor %0" :: "r"(addr));
+		if (*addr != val) return;
+		__asm__ volatile ("umwait %0" :: "r"(0u), "a"((unsigned)dl), "d"((unsigned)(dl>>32)) : "cc");
+	} else {
+		__asm__ volatile ("monitorx" :: "a"(addr), "c"(0), "d"(0));
+		if (*addr != val) return;
+		__asm__ volatile ("mwaitx" :: "a"(0xF0u), "c"(0x2u), "b"(500000u));
+	}
+}
