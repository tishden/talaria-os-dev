NAME=postgresql
PORT=5432
PROTO=pg
DISK_MB=512
SMP=2
MEM=1024
BOOT_WAIT=90
CONNS=4
# select1 — a round trip of the protocol and the planner on a trivial query
# pk      — fetching one row by primary key from a table of 100 thousand
PROBE_ARGS="--user postgres --db postgres"
CASES="select1:--op query --user postgres --db postgres --query 'SELECT 1'|pk:--op query --user postgres --db postgres --query 'SELECT v FROM tlbench WHERE id = 42'"
WARMUP_CMD='"$TLGEN" --proto pg --host "$GUEST_IP" --port "$PORT" --user postgres --db postgres --query "CREATE TABLE IF NOT EXISTS tlbench(id int primary key, v text); INSERT INTO tlbench SELECT g, md5(g::text) FROM generate_series(1,100000) g ON CONFLICT DO NOTHING; ANALYZE tlbench" --conns 1 --count 1 --rate 0 --duration 120 --warmup 0 --timeout 120 --spin --out /dev/null >/dev/null 2>&1'
# THE DATA DIRECTORY. The Linux guest boots from an initramfs, i.e. its root is
# MEMORY; without this line the database on Linux would write its journal into RAM
# while on Talaria it goes to a real disk, and MEDIA would be compared (see run-local.sh).
DATADIR=/pgdata
