# The PostgreSQL 16 postmaster on Talaria: the process model (fork/signals/shm/ext2).
binary=/opt/pg/bin/postgres
args=postgres -D /pgdata
env=PGDATA=/pgdata
env=HOME=/
env=PATH=/opt/pg/bin

# ── Measured settings (see the header of kernel/src/cellman.rs) ─────────────
# netyield: how often a thread waiting for the network gives the core to its neighbours.
# The number was chosen BY MEASUREMENT ON EXACTLY THIS WORKLOAD (a sweep of
# 0/2/5/10/20/100 µs): at zero p50 was 1148 µs, at 2-10 µs it is 66-77 µs with a ceiling of
# 18-20 thousand req/s instead of 8.9 thousand, and at 100 µs it gets worse again. The
# reason is exactly PostgreSQL's process model: there are many backends, each spinning in
# epoll_wait, and without yielding the core they hold the machine from one another. So it
# is declared here — next to the workload it was measured on, not in the stand's command line.
netyield=5
# netmix: a waiter whose set is not only sockets PARKS for at most this many ns instead of
# spinning. Every PostgreSQL process waits on a latch's signalfd/self-pipe and the
# postmaster's death pipe next to its sockets, so without it the postmaster and the
# background workers (checkpointer, bgwriter, walwriter, the autovacuum launcher) spun
# their whole timeouts and held the cores from the backends — the "slow state" of the arm64
# board. Measured on c7g.xlarge smp=2 against phase A of the same stand twice
# (2026-10-25): the pk ceiling 9.9 -> 18.8-18.9 thousand, select1 26.6-26.8 -> 31.5-35.4
# thousand, p50 -5..-13 %, p99 -10..-16 %. The pipe/eventfd/signal producers kick the
# sleepers (netsys::mix_kick), so the ceiling bounds only a timerfd's lateness.
netmix=1000000
# netmixsteal: under netmix the polling slot goes to a waiter with traffic younger than this,
# taken from one without. The postmaster enters its epoll_wait first and kept the slot for
# the whole run, spinning, while the backends the requests came for parked (the stat block's
# "the slot" lines). Measured on c7g.xlarge smp=2 against phase A of the same stand, with a
# third phase of the knob off as the drift control (2026-10-25): the select1 ceiling 36.0 ->
# 58.0 thousand (Linux 44.3), pk 18.4 -> 21.2 thousand (Linux 24.6); at the top rungs p99
# select1@32k 507 -> 78 us, pk@16.6k 921 -> 307 us; the low rungs unchanged or -5..-10 %.
netmixsteal=1000000
