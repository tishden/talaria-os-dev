NAME=mysql
PORT=3306
PROTO=mysql
DISK_MB=768
SMP=2
MEM=1024
BOOT_WAIT=120
CONNS=4
CASES="select1:--op query --user root --db mysql --query 'SELECT 1'|pk:--op query --user root --db tlbench --query 'SELECT v FROM t WHERE id = 42'"
WARMUP_CMD='"$TLGEN" --proto mysql --host "$GUEST_IP" --port "$PORT" --user root --db mysql --query "CREATE DATABASE IF NOT EXISTS tlbench" --conns 1 --count 1 --rate 0 --duration 120 --warmup 0 --timeout 120 --spin --out /dev/null >/dev/null 2>&1; "$TLGEN" --proto mysql --host "$GUEST_IP" --port "$PORT" --user root --db tlbench --query "CREATE TABLE IF NOT EXISTS t(id int primary key, v varchar(64)) ENGINE=InnoDB" --conns 1 --count 1 --rate 0 --duration 120 --warmup 0 --timeout 120 --spin --out /dev/null >/dev/null 2>&1; "$TLGEN" --proto mysql --host "$GUEST_IP" --port "$PORT" --user root --db tlbench --query "INSERT IGNORE INTO t SELECT seq, md5(seq) FROM seq_1_to_100000" --conns 1 --count 1 --rate 0 --duration 120 --warmup 0 --timeout 120 --spin --out /dev/null >/dev/null 2>&1'
# THE DATA DIRECTORY. The Linux guest boots from an initramfs, i.e. its root is
# MEMORY; without this line the database on Linux would write its journal into RAM
# while on Talaria it goes to a real disk, and MEDIA would be compared (see run-local.sh).
DATADIR=/data
# The "the server answers" probe (ab-phase.sh): the server rejects a ping without a database.
PROBE_ARGS="--op ping --user root --db mysql"
