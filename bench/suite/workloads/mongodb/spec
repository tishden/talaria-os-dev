ip=@GUEST_IP@/24
gw=@HOST_IP@
tune=lowlat
exec=/usr/bin/mongod
arg=mongod
arg=--dbpath
arg=/data/db
arg=--bind_ip_all
arg=--port
arg=27017
arg=--wiredTigerCacheSizeGB
arg=0.25
arg=--setParameter
arg=diagnosticDataCollectionEnabled=false
arg=--setParameter
arg=disableLogicalSessionCacheRefresh=true
arg=--nounixsocket
arg=--quiet
env=HOME=/
env=LD_LIBRARY_PATH=/usr/lib:/lib
env=PATH=/usr/bin:/bin
