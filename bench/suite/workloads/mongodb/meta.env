NAME=mongodb
PORT=27017
PROTO=mongo
DISK_MB=768
SMP=2
MEM=1536
BOOT_WAIT=180
CONNS=4
GUEST_MODULES="virtio_net virtio_pci virtio_mmio"
# ping   — a protocol round trip (OP_MSG) without touching data
# find   — fetching one document
# insert — writing a 64-byte document
CASES="ping:--op ping|find:--op find --db tlbench --coll t|insert:--op insert --db tlbench --coll t --valsize 64"
WARMUP_CMD='"$TLGEN" --proto mongo --host "$GUEST_IP" --port "$PORT" --op insert --db tlbench --coll t --valsize 64 --conns 2 --rate 0 --duration 3 --warmup 0 --spin --out /dev/null >/dev/null 2>&1'
# THE DATA DIRECTORY. The Linux guest boots from an initramfs, i.e. its root is
# MEMORY; without this line the database on Linux would write its journal into RAM
# while on Talaria it goes to a real disk, and MEDIA would be compared (see run-local.sh).
DATADIR=/data/db
