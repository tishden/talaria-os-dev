NAME=redis
PORT=6379
PROTO=resp
DISK_MB=64
SMP=1
MEM=512
# ping   — a pure protocol round trip, without touching data
# get    — a read by a random key from a warmed-up keyspace
# set    — writing a 100-byte value
# mixed  — 90 % reads, 10 % writes: the usual shape of a cache workload
CASES="ping:--op ping|get:--op get --keyspace 100000|set:--op set --keyspace 100000 --valsize 100|mixed:--op mixed --read-pct 90 --keyspace 100000 --valsize 100"
# The keyspace is filled BEFORE the measurement: otherwise `get` measures a protocol
# round trip on misses rather than reading data.
WARMUP_CMD='"$TLGEN" --proto resp --host "$GUEST_IP" --port "$PORT" --op set --keyspace 100000 --valsize 100 --conns 4 --rate 0 --duration 3 --warmup 0 --spin --out /dev/null >/dev/null 2>&1'
